# Copie para .env e ajuste. Nunca coloque segredos reais neste arquivo.
# O backend lê estas variáveis do ambiente do processo (não carrega .env sozinho).
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://conectaja:conectaja@localhost:5432/conectaja

# Frontend (opcional): destino do proxy de /api no `npm run dev`
# VITE_API_PROXY_TARGET=http://localhost:8000
